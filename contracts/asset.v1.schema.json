{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/contracts/photos/asset.v1.schema.json",
  "title": "GoreeCloud Photos Asset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_id",
    "library_id",
    "owner_subject_id",
    "media_type",
    "content_sha256",
    "byte_size",
    "imported_at",
    "revision",
    "favorite",
    "lifecycle_state",
    "protection_state",
    "processing_state",
    "server_storage_state"
  ],
  "properties": {
    "asset_id": {"type": "string", "format": "uuid"},
    "library_id": {"type": "string", "format": "uuid"},
    "owner_subject_id": {"type": "string", "minLength": 1},
    "media_type": {"type": "string", "minLength": 1},
    "original_filename": {"type": ["string", "null"]},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "byte_size": {"type": "integer", "minimum": 0},
    "capture_time": {"type": ["string", "null"], "format": "date-time"},
    "capture_time_zone": {"type": ["string", "null"]},
    "imported_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "favorite": {"type": "boolean"},
    "lifecycle_state": {"enum": ["active", "archived", "trash", "purged"]},
    "protection_state": {"enum": ["standard", "protected"]},
    "processing_state": {"enum": ["pending", "ready", "degraded", "failed"]},
    "server_storage_state": {"enum": ["staging", "verified", "unavailable", "corrupt"]}
  }
}
