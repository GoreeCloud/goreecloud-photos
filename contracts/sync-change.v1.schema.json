{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goreecloud.com/contracts/photos/sync-change.v1.schema.json",
  "title": "GoreeCloud Photos Sync Change v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "library_id",
    "resource_type",
    "resource_id",
    "operation",
    "revision",
    "changed_at"
  ],
  "properties": {
    "change_id": {"type": "string", "minLength": 1},
    "library_id": {"type": "string", "format": "uuid"},
    "resource_type": {
      "enum": ["asset", "album", "album_membership", "share_grant", "share_link", "library_membership", "edit_revision"]
    },
    "resource_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["create", "update", "delete", "restore"]},
    "revision": {"type": "integer", "minimum": 1},
    "changed_at": {"type": "string", "format": "date-time"}
  }
}
